# Copy this file to .env and paste your free API keys in.
# Never commit .env. It is gitignored.

# 1. Google AI Studio (free tier, no card required)
#    Get one at: https://aistudio.google.com/apikey
#    This is the important one. It supports live Google Search grounding,
#    which is the closest free proxy to what a real buyer sees.
GEMINI_API_KEY=

# 2. Groq (free tier, no card required)
#    Get one at: https://console.groq.com/keys
#    No search grounding. This measures the model's *memory*, which is
#    a separate and genuinely interesting axis for us.
GROQ_API_KEY=

# 3. OpenRouter (optional, free-tier models available)
#    Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
